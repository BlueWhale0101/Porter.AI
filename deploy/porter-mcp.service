[Unit]
Description=Porter private MCP endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=porter
Group=porter
WorkingDirectory=/opt/porter/current
Environment=NODE_ENV=production
Environment=PORTER_MCP_HOST=127.0.0.1
Environment=PORTER_MCP_PORT=8791
EnvironmentFile=/etc/porter/runtime.env
EnvironmentFile=/etc/porter/mcp.env
ExecStart=/usr/bin/node mcp/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
