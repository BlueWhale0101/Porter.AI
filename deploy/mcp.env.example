# Server-only Porter.AI MCP credentials.
# Install as /etc/porter/mcp.env, owner root:porter, mode 0640.
# Never copy these values into the web/PWA runtime environment.

# Stable random bearer credential configured as the custom MCP server's authentication token.
PORTER_MCP_BEARER_TOKEN=

# Supabase server secret/service-role credential. Used only by the loopback MCP
# process. The semantic service is hard-scoped to PORTER_OWNER_ID from runtime.env.
PORTER_MCP_SUPABASE_KEY=
